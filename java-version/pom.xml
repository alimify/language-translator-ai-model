<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>translator</groupId>
    <artifactId>translator-ai-java</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    
    <name>Translator AI (Java)</name>
    <description>English-Bengali Neural Machine Translation with Transformer</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javacpp.version>1.5.12</javacpp.version>
        <pytorch.version>2.7.1-${javacpp.version}</pytorch.version>
        <!-- SentencePiece 0.2.0 bindings (latest published preset build is
             against JavaCPP 1.5.11; binary-compatible with the 1.5.12 core). -->
        <sentencepiece.version>0.2.0-1.5.11</sentencepiece.version>
    </properties>

    <dependencies>
        <!-- JavaCPP PyTorch (LibTorch bindings) -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>pytorch-platform</artifactId>
            <version>${pytorch.version}</version>
        </dependency>

        <!-- JavaCPP SentencePiece (in-process tokenizer, matches Python) -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>sentencepiece-platform</artifactId>
            <version>${sentencepiece.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.9</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>translator.Main</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Copy all runtime dependencies next to the jar so that
                 `java -jar target/translator-ai-java-1.0.0.jar` resolves the
                 manifest Class-Path (lib/*.jar) without a shaded jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
